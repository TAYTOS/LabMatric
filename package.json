{
  "name": "labmatric",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --no-ignore",
    "preview": "vite preview --host 0.0.0.0 --open",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "verify": "npm run build && npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^11.5.4",
    "jspdf": "^3.0.4",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "latest",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
